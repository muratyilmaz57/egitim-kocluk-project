# Copy this file to .env.deploy.staging or .env.deploy.production
# and update the values before running `npm run deploy:staging`
# or `npm run deploy:prod`.

PLESK_BASE_URL="https://your-plesk-host:8443"
PLESK_API_KEY="replace-me"
DEPLOY_PARENT_DOMAIN="example.com"
DEPLOY_FTP_HOST="203.0.113.10"
DEPLOY_NODE_VERSION="24.14.0"

# Environment identity
DEPLOY_ENV_NAME="staging"
DEPLOY_APP_NAME="Kocluk Platformu Staging"

# Public domains
DEPLOY_WEB_DOMAIN="staging-ftykocluk.example.com"
DEPLOY_API_DOMAIN="api-staging-ftykocluk.example.com"
DEPLOY_WEB_BASE_URL="https://staging-ftykocluk.example.com"
DEPLOY_API_BASE_URL="https://api-staging-ftykocluk.example.com/api/v1"

# Optional internal server-side API route
DEPLOY_INTERNAL_API_BASE_URL="http://api-staging-ftykocluk.example.com/api/v1"

# Runtime secrets
DEPLOY_DATABASE_URL="mysql://user:encoded_password@localhost:3306/db_name"
DEPLOY_JWT_ACCESS_SECRET="replace-me"
DEPLOY_JWT_REFRESH_SECRET="replace-me"
DEPLOY_JWT_CAPTCHA_SECRET="replace-me"
DEPLOY_APP_ENCRYPTION_SECRET="replace-me"

# FTP accounts
DEPLOY_WEB_FTP_USER="replace-me"
DEPLOY_WEB_FTP_PASS="replace-me"
DEPLOY_API_FTP_USER="replace-me"
DEPLOY_API_FTP_PASS="replace-me"

# Optional DB import during deploy
DEPLOY_SQL_DUMP_PATH=""
DEPLOY_SQL_DUMP_REMOTE_NAME="deploy-staging.sql"
DEPLOY_IMPORT_DB_NAME=""
DEPLOY_IMPORT_DB_DOMAIN=""

# Optional: skip local build if artifacts are already ready
DEPLOY_SKIP_BUILD="0"
